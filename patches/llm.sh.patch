 # Detect ROCm version
 # Returns: version string (e.g., "7.2.0") or "unknown"
 get_rocm_version() {
+    # PATCHED: original piped rocminfo into grep with no failure guard. Under
+    # `set -euo pipefail` a non-matching grep exits 1, pipefail propagates it,
+    # and the caller's `version=$(get_rocm_version)` assignment kills the script.
+    # Ubuntu's rocminfo never emits "ROCm Runtime Version:", so this always fired.
+    local v=""
     if command -v rocminfo &>/dev/null; then
-        rocminfo 2>/dev/null | grep -oP 'ROCm Runtime Version: \K[0-9.]+' | head -1
-    elif [[ -f /opt/rocm/.info/version ]]; then
-        cat /opt/rocm/.info/version 2>/dev/null
-    else
-        echo "unknown"
+        v=$(rocminfo 2>/dev/null | grep -oP 'ROCm Runtime Version: \K[0-9.]+' | head -1 || true)
+    fi
+    if [[ -z "$v" && -f /opt/rocm/.info/version ]]; then
+        v=$(cat /opt/rocm/.info/version 2>/dev/null || true)
+    fi
+    # Ubuntu packages ROCm into /usr, not /opt/rocm — ask dpkg as a last resort.
+    if [[ -z "$v" ]] && command -v dpkg-query &>/dev/null; then
+        v=$(dpkg-query -W -f='${Version}' rocminfo 2>/dev/null | grep -oP '^[0-9]+\.[0-9]+(\.[0-9]+)?' || true)
     fi
+    echo "${v:-unknown}"
 }
 
 # Check if ROCm version is 7.2 or higher (native gfx1151 support)
 rocm_has_native_gfx1151() {
     local version
+
+    # PATCHED: authoritative check first. If the installed ROCm runtime actually
+    # enumerates a gfx1151 agent, it supports the ISA natively and no
+    # HSA_OVERRIDE_GFX_VERSION is needed. The original gated purely on a version
+    # string >= 7.2; Ubuntu 26.04 ships ROCm 7.1.1, which DOES support gfx1151,
+    # so the version test wrote HSA_OVERRIDE_GFX_VERSION=11.0.0 and forced
+    # gfx1100 kernels onto Strix Halo hardware.
+    if command -v rocminfo &>/dev/null && \
+       rocminfo 2>/dev/null | grep -q 'gfx1151'; then
+        return 0
+    fi
+
     version=$(get_rocm_version)
     
     if [[ "$version" == "unknown" ]]; then
